# Which environment this process is: development (the default) or
# production. Only production reports to PostHog. Deployed images set it
# themselves; nothing infers it from a hostname or a log level.
APP_ENV=development

# TMDb auth: either a v3 API key or a v4 read access token (Bearer). One is enough.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# OMDb (omdbapi.com) key for real IMDb ratings; free tier is 1,000 requests
# a day. Leave empty to skip IMDb ratings.
OMDB_API_KEY=

# Outgoing TMDb request rate; the client defaults to 40/s (TMDb allows ~50/s).
TMDB_RATE_PER_SEC=

# Redis holds raw TMDb/OMDb responses (redis://[:password@]host:port[/db]).
# Leave empty to skip caching. TMDB_CACHE_TTL is the Redis TTL for TMDb
# entries; OMDb ratings use a 30-day TTL in code.
REDIS_URL=
TMDB_CACHE_TTL=168h

# Crawl scoring overrides; see internal/crawl/score.go for the defaults.
CRAWL_THRESHOLD_BASE=
CRAWL_ORDER_PENALTY=

# Public traffic limits. RATE_LIMIT_PER_SEC=0 disables per-client rate
# limiting (local development); unset takes the defaults in
# internal/api/limit.go. MAX_COLD_CRAWLS caps first-visit crawls in flight
# across all clients.
RATE_LIMIT_PER_SEC=
RATE_LIMIT_BURST=
MAX_COLD_CRAWLS=

API_ADDR=:8080
# Serve the built frontend from here (run `npm run build` in web/ first).
WEB_DIR=web/dist

# PostHog, read only when APP_ENV=production. The API serves these to the
# map from GET /api/analytics-config; the project token is a write-only
# key, the same credential posthog-js would otherwise be built with.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
