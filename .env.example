# Which environment this process is: development (the default) or
# production. Only production reports to PostHog. Deployed images set it
# themselves; nothing infers it from a hostname or a log level.
APP_ENV=development

# ---- catalog ----
#
# Postgres holds the whole movie catalog, built from the IMDb datasets by
# cmd/importer. The API only ever reads it; the importer is the only
# thing that writes. See internal/catalog/README.md.
DATABASE_URL=postgres://user:password@localhost:5432/cinedikt

# Connection pools, kept apart so a bulk COPY during an import cannot
# take the connections a reader needs. Unset takes the defaults in
# internal/config/config.go (10 and 4).
CATALOG_API_MAX_CONNS=
CATALOG_IMPORTER_MAX_CONNS=

# OMDb (omdbapi.com) supplies the one thing the IMDb dump has not: a
# poster address and a full release date. The key never leaves the
# server. Leave empty and the catalog still works, without pictures and
# with cards ordered by year alone.
OMDB_API_KEY=

# How fast the poster backfill asks, and how many lookups run at once.
# There are about 757,000 movies, so a full first pass is roughly
# 757000/rate seconds. The workers are what make the rate reachable: one
# lookup at a time is bounded by the round trip, not by the limit.
# Unset takes the defaults (160/s over 32 workers).
OMDB_BACKFILL_RATE=
POSTER_WORKERS=

# ---- serving ----

API_ADDR=:8080
# Serve the built frontend from here (run `npm run build` in web/ first).
WEB_DIR=web/dist

# Public traffic limits. RATE_LIMIT_PER_SEC=0 disables per-client rate
# limiting (local development); unset takes the defaults in
# internal/api/limit.go.
RATE_LIMIT_PER_SEC=
RATE_LIMIT_BURST=

# Railway and the like inject this; API_ADDR wins when both are set.
PORT=

# PostHog, read only when APP_ENV=production. The API serves these to the
# map from GET /api/analytics-config; the project token is a write-only
# key, the same credential posthog-js would otherwise be built with.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# ---- the old crawling map ----
#
# These belong to the TMDb/Neo4j map the catalog replaced. Nothing reads
# them while DATABASE_URL is set, and a deployment does not need them.
# They are still accepted so the old path can be run until its packages
# come out of the tree.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_RATE_PER_SEC=
TMDB_CACHE_TTL=168h
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=
CRAWL_THRESHOLD_BASE=
CRAWL_ORDER_PENALTY=
MAX_COLD_CRAWLS=
